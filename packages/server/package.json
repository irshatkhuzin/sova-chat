{
  "name": "@sova/server",
  "version": "0.1.0",
  "private": true,
  "description": "Sova support server: REST API, realtime messaging, AI, and translation",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node -r dotenv/config -r ts-node/register src/server.ts dotenv_config_path=../../.env",
    "dev:worker": "node -r dotenv/config -r ts-node/register src/worker.ts dotenv_config_path=../../.env",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "migrate": "node -r dotenv/config -r ts-node/register src/cli/migrate.ts dotenv_config_path=../../.env",
    "create-operator": "node -r dotenv/config -r ts-node/register src/cli/create-operator.ts dotenv_config_path=../../.env",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@sova/shared": "0.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "geoip-lite": "1.4.10",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}
