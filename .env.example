# Copy to .env. Configure your own secrets and services; never commit .env.
# Local Compose database password: sova. Use separate credentials in production.
# Generate two independent application secrets with at least 32 random characters.
# Provider prices below are examples; verify current prices before enabling budgets.
# The operator workflow currently uses Russian.
# Changing APP_ENCRYPTION_KEY makes existing encrypted secrets unreadable.

NODE_ENV=development
PORT=4000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:4000
PANEL_URL=http://localhost:5173
TRUST_PROXY=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sova
DB_PASSWORD=
DB_NAME=sova
DB_CONNECTION_LIMIT=10
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=3
REDIS_TLS=false
REDIS_PREFIX=sova
WORKER_CONCURRENCY=2
JWT_SECRET=change-me-to-a-long-random-string-32+
APP_ENCRYPTION_KEY=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
CLIENT_SESSION_TTL_DAYS=180
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2
OPENAI_PRICE_INPUT_PER_MTOK=2.50
OPENAI_PRICE_OUTPUT_PER_MTOK=10.00
OPENAI_TRANSLATION_PRICE_INPUT_PER_MTOK=0.15
OPENAI_TRANSLATION_PRICE_OUTPUT_PER_MTOK=0.60
TRANSLATION_PROVIDER=llm
OPERATOR_LANGUAGE=ru
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_MIME=image/png,image/jpeg,image/gif,image/webp
MAX_MESSAGE_LENGTH=4000
RATE_LIMIT_CLIENT_MESSAGES_PER_MIN=20
RATE_LIMIT_CLIENT_SESSIONS_PER_HOUR=30
RATE_LIMIT_LOGIN_PER_15MIN=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
LOG_LEVEL=info
